# MongoDB Docker container credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin
MONGO_DB_NAME=exan

# Application connection string (used by webapp/auth/inference services)
MONGO_URI=mongodb://exan_app:exan_app_password@localhost:27017/exan?authSource=exan

# Auth
JWT_SECRET=change-this-to-a-random-secret
PORT=3001
