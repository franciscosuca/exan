{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exan",
  "version": "1.0.0",
  "identifier": "com.exan.desktop",
  "build": {
    "frontendDist": "../../webapp/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Exan",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/exan-inference"]
  }
}
