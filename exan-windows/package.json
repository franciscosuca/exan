{
  "name": "exan-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Exan for Windows - local exam correction with small on-device vision models",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/sidecar-task.mjs setup && node scripts/build-sidecar.mjs",
    "start": "node scripts/build-sidecar.mjs --if-needed && tauri dev",
    "package": "node scripts/build-sidecar.mjs && tauri build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "dev": "vite",
    "dev:engine": "node scripts/sidecar-task.mjs dev",
    "dev:browser": "vite --mode browser",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:engine": "node scripts/sidecar-task.mjs test",
    "lint": "oxlint src scripts",
    "lint:engine": "node scripts/sidecar-task.mjs lint",
    "check": "tsc --noEmit && npm run lint && npm run test && npm run lint:engine && npm run test:engine",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
