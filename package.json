{
  "name": "exan",
  "version": "1.6.0",
  "description": "AI-powered exam scanning and grading application",
  "private": true,
  "scripts": {
    "dev:webapp": "cd webapp && bun run dev",
    "dev:inference": "cd inference && uv run uvicorn app.main:app --reload --port 8000",
    "dev:auth": "tsx watch auth/server.ts",
    "start:auth": "tsx auth/server.ts",
    "db:start": "docker compose up -d mongodb",
    "db:stop": "docker compose stop mongodb",
    "db:reset": "docker compose down -v && docker compose up -d mongodb",
    "build:webapp": "cd webapp && bun run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.16.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franciscosuca/exan.git"
  },
  "author": "franciscosuca",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  }
}
