{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["db/**/*.ts", "auth/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
