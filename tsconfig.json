{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["db/**/*.ts", "auth/**/*.ts", "webapp/src/**/*.ts", "webapp/src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
